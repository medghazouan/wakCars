# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (Hostinger MariaDB — co-located) ────────────────────────────────
DATABASE_URL="mysql://wakcars_user:your_password@localhost:3306/wakcars"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=wakcars
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email — Resend SMTP ──────────────────────────────────────────────────────
# Required for confirmation / invoice / damage emails (logs a warning if missing).
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_API_KEY=re_your_resend_api_key
# Must be a domain you verified in Resend (or use Resend's onboarding domain for tests)
EMAIL_FROM=noreply@wakcars.ma
EMAIL_FROM_NAME=Wak Cars

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ─── Cron Security ────────────────────────────────────────────────────────────
# Token required by cron-job.org when calling /api/cron/run-jobs
CRON_SECRET=your_cron_secret_token

# ─── WhatsApp Business ────────────────────────────────────────────────────────
WHATSAPP_BUSINESS_PHONE=+212661234567
